<?xml version="1.0" encoding="UTF-8"?>
<csls:SystemHistory xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:csls="https://vnu.edu.vn/sme/goal/csl/state/3.0"
    xsi:schemaLocation="https://vnu.edu.vn/sme/goal/csl/state/3.0 csl-state.ecore"
    xmi:id="systemHistory" name="MeetingSchedulerRuntime">

  <model href="mtg-development.csl.xmi#cslModel"/>

  <!-- Stable runtime identities. Their attribute values and links live in checkpoints. -->
  <instances xsi:type="csls:ActorOccurrence" xmi:id="org1" id="org1">
    <classifier xsi:type="csls:Actor" href="mtg-development.csl.xmi#organizationActor"/>
  </instances>
  <instances xsi:type="csls:ActorOccurrence" xmi:id="unit1" id="unit1">
    <classifier xsi:type="csls:Actor" href="mtg-development.csl.xmi#meetingUnitActor"/>
  </instances>
  <instances xsi:type="csls:ActorOccurrence" xmi:id="alice" id="alice">
    <classifier xsi:type="csls:Actor" href="mtg-development.csl.xmi#personActor"/>
  </instances>
  <instances xsi:type="csls:ActorOccurrence" xmi:id="bob" id="bob">
    <classifier xsi:type="csls:Actor" href="mtg-development.csl.xmi#personActor"/>
  </instances>
  <instances xsi:type="csls:ActorOccurrence" xmi:id="organizer1" id="organizer1">
    <classifier xsi:type="csls:Actor" href="mtg-development.csl.xmi#organizerActor"/>
  </instances>
  <instances xsi:type="csls:ActorOccurrence" xmi:id="participant1" id="participant1">
    <classifier xsi:type="csls:Actor" href="mtg-development.csl.xmi#participantActor"/>
  </instances>
  <instances xsi:type="csls:EntityObject" xmi:id="meeting1" id="meeting1">
    <classifier xsi:type="csls:Entity" href="mtg-development.csl.xmi#meetingEntity"/>
  </instances>
  <instances xsi:type="csls:EntityObject" xmi:id="calendar1" id="calendar1">
    <classifier xsi:type="csls:Entity" href="mtg-development.csl.xmi#calendarEntity"/>
  </instances>

  <!-- s0: organization and role structure exists, but the meeting goal is pending. -->
  <states xmi:id="s0" name="BeforeScheduling" step="0"
      activeInstances="org1 unit1 alice bob organizer1 participant1 meeting1 calendar1">
    <values owner="org1" attribute="mtg-development.csl.xmi#coordinationScore" value="0"/>
    <values owner="alice" attribute="mtg-development.csl.xmi#personName" value="Alice"/>
    <values owner="alice" attribute="mtg-development.csl.xmi#workingHours" value="7"/>
    <values owner="bob" attribute="mtg-development.csl.xmi#personName" value="Bob"/>
    <values owner="bob" attribute="mtg-development.csl.xmi#workingHours" value="6"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantTimetableCollected" value="true"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantChannel" value="calendar"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantNotified" value="false"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantAttended" value="false"/>
    <values owner="meeting1" attribute="mtg-development.csl.xmi#meetingDetailsDecided" value="true"/>
    <values owner="meeting1" attribute="mtg-development.csl.xmi#meetingTimeChosen" value="false"/>
    <values owner="meeting1" attribute="mtg-development.csl.xmi#meetingAnnounced" value="false"/>
    <values owner="calendar1" attribute="mtg-development.csl.xmi#calendarAvailable" value="true"/>

    <links source="org1" target="unit1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#organizationUnits"/>
    </links>
    <links source="unit1" target="organizer1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#unitOrganizers"/>
    </links>
    <links source="unit1" target="participant1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#unitParticipants"/>
    </links>
    <links source="unit1" target="meeting1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#unitMeetings"/>
    </links>
    <links source="alice" target="organizer1">
      <relationship xsi:type="csls:Association" href="mtg-development.csl.xmi#enactsMeetingParty"/>
    </links>
    <links source="bob" target="participant1">
      <relationship xsi:type="csls:Association" href="mtg-development.csl.xmi#enactsMeetingParty"/>
    </links>
    <links source="participant1" target="calendar1">
      <relationship xsi:type="csls:Aggregation" href="mtg-development.csl.xmi#participantCalendars"/>
    </links>
  </states>

  <!-- s1: a BPMN execution established the group goal but caused Alice's personal goal to fail. -->
  <states xmi:id="s1" name="AfterMeetingExecution" step="1"
      activeInstances="org1 unit1 alice bob organizer1 participant1 meeting1 calendar1">
    <values owner="org1" attribute="mtg-development.csl.xmi#coordinationScore" value="1"/>
    <values owner="alice" attribute="mtg-development.csl.xmi#personName" value="Alice"/>
    <values owner="alice" attribute="mtg-development.csl.xmi#workingHours" value="9"/>
    <values owner="bob" attribute="mtg-development.csl.xmi#personName" value="Bob"/>
    <values owner="bob" attribute="mtg-development.csl.xmi#workingHours" value="6"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantTimetableCollected" value="true"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantChannel" value="calendar"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantNotified" value="true"/>
    <values owner="participant1" attribute="mtg-development.csl.xmi#participantAttended" value="true"/>
    <values owner="meeting1" attribute="mtg-development.csl.xmi#meetingDetailsDecided" value="true"/>
    <values owner="meeting1" attribute="mtg-development.csl.xmi#meetingTimeChosen" value="true"/>
    <values owner="meeting1" attribute="mtg-development.csl.xmi#meetingAnnounced" value="true"/>
    <values owner="calendar1" attribute="mtg-development.csl.xmi#calendarAvailable" value="true"/>

    <links source="org1" target="unit1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#organizationUnits"/>
    </links>
    <links source="unit1" target="organizer1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#unitOrganizers"/>
    </links>
    <links source="unit1" target="participant1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#unitParticipants"/>
    </links>
    <links source="unit1" target="meeting1">
      <relationship xsi:type="csls:Composition" href="mtg-development.csl.xmi#unitMeetings"/>
    </links>
    <links source="alice" target="organizer1">
      <relationship xsi:type="csls:Association" href="mtg-development.csl.xmi#enactsMeetingParty"/>
    </links>
    <links source="bob" target="participant1">
      <relationship xsi:type="csls:Association" href="mtg-development.csl.xmi#enactsMeetingParty"/>
    </links>
    <links source="participant1" target="calendar1">
      <relationship xsi:type="csls:Aggregation" href="mtg-development.csl.xmi#participantCalendars"/>
    </links>
  </states>
</csls:SystemHistory>
