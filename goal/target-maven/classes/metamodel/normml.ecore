    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/LPG">
      <details key="NonEmptyExpression" value="condExpr.size() &gt; 0"/>
      <details key="NonEmptyLanguage" value="condLang.size() &gt; 0"/>
    </eAnnotations>
  </eClassifiers>
</ecore:EPackage>
